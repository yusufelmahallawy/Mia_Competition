<?xml version="1.0" ?>

<sdf version="1.9">

  <model name="mecanum_robot">

    <!-- ========================= -->
    <!-- ROBOT BASE -->
    <!-- ========================= -->

    <link name="base_link">

      <pose>0 0 0.20 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>

        <inertia>
          <ixx>0.25</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.45</iyy>
          <iyz>0.0</iyz>
          <izz>0.55</izz>
        </inertia>
      </inertial>

      <visual name="base_visual">

        <geometry>
          <box>
            <size>0.60 0.45 0.20</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>

      </visual>

      <collision name="base_collision">

        <geometry>
          <box>
            <size>0.60 0.45 0.20</size>
          </box>
        </geometry>

      </collision>

    </link>


    <!-- ========================= -->
    <!-- FRONT LEFT WHEEL -->
    <!-- ========================= -->

    <link name="front_left_wheel">

      <pose>0.20 0.28 0.10 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.005</iyy>
          <iyz>0.0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>

              <mu>1.0</mu>
              <mu2>0.0</mu2>

              <fdir1 gz:expressed_in="base_link">
                1 -1 0
              </fdir1>

            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ========================= -->
    <!-- FRONT RIGHT WHEEL -->
    <!-- ========================= -->

    <link name="front_right_wheel">

      <pose>0.20 -0.28 0.10 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.005</iyy>
          <iyz>0.0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>

              <mu>1.0</mu>
              <mu2>0.0</mu2>

              <fdir1 gz:expressed_in="base_link">
                1 1 0
              </fdir1>

            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ========================= -->
    <!-- REAR LEFT WHEEL -->
    <!-- ========================= -->

    <link name="rear_left_wheel">

      <pose>-0.20 0.28 0.10 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.005</iyy>
          <iyz>0.0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>

              <mu>1.0</mu>
              <mu2>0.0</mu2>

              <fdir1 gz:expressed_in="base_link">
                1 1 0
              </fdir1>

            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ========================= -->
    <!-- REAR RIGHT WHEEL -->
    <!-- ========================= -->

    <link name="rear_right_wheel">

      <pose>-0.20 -0.28 0.10 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.005</iyy>
          <iyz>0.0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="visual">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>

              <mu>1.0</mu>
              <mu2>0.0</mu2>

              <fdir1 gz:expressed_in="base_link">
                1 -1 0
              </fdir1>

            </ode>
          </friction>
        </surface>

      </collision>

    </link>


    <!-- ========================= -->
    <!-- WHEEL JOINTS -->
    <!-- ========================= -->

    <joint name="front_left_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>front_left_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>

    </joint>


    <joint name="front_right_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>front_right_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>

    </joint>


    <joint name="rear_left_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>rear_left_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>

    </joint>


    <joint name="rear_right_wheel_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>rear_right_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>

    </joint>


    <!-- ========================= -->
    <!-- GAZEBO MECANUM DRIVE -->
    <!-- ========================= -->

    <plugin
      filename="gz-sim-mecanum-drive-system"
      name="gz::sim::systems::MecanumDrive">

      <front_left_joint>
        front_left_wheel_joint
      </front_left_joint>

      <front_right_joint>
        front_right_wheel_joint
      </front_right_joint>

      <back_left_joint>
        rear_left_wheel_joint
      </back_left_joint>

      <back_right_joint>
        rear_right_wheel_joint
      </back_right_joint>

      <wheel_separation>0.56</wheel_separation>

      <wheelbase>0.40</wheelbase>

      <wheel_radius>0.10</wheel_radius>

      <topic>/cmd_vel</topic>

      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>

    </plugin>

  </model>

</sdf>