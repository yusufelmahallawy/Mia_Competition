<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="piston_cup_arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OUTER WALLS ====================
         Field: 2.80 m (X, width) x 3.30 m (Y, length)
         Wall thickness = 0.06 m, height = 0.10 m (assumed height)
         Origin (0,0) = center of the whole field
         +Y = Shato side, -Y = Ulker side -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 1.68 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.92 0.06 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.92 0.06 0.10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.68 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.92 0.06 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.92 0.06 0.10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>1.43 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.06 3.30 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.06 3.30 0.10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-1.43 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.06 3.30 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.06 3.30 0.10</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== MIDDLE DIVIDER (marking line, not a real barrier) ==================== -->
    <model name="middle_divider">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.80 0.06 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.80 0.06 0.10</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== START ZONES (visual only, no collision) ====================
         60 cm x 50 cm each, corner-located -->

    <model name="shato_start_zone">
      <static>true</static>
      <pose>1.10 1.40 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.60 0.50 0.005</size></box></geometry>
          <material><ambient>1.0 0.55 0.0 0.6</ambient><diffuse>1.0 0.55 0.0 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ulker_start_zone">
      <static>true</static>
      <pose>-1.10 -1.40 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.60 0.50 0.005</size></box></geometry>
          <material><ambient>0.0 0.7 0.9 0.6</ambient><diffuse>0.0 0.7 0.9 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== BLUE BOXES (assumed 20x20x20 cm each) ==================== -->

    <model name="blue_box_1">
      <pose>-0.75 0.85 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.20 0.20 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material><ambient>0.0 0.0 0.6 1</ambient><diffuse>0.0 0.0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box_2">
      <pose>0.75 0.85 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.20 0.20 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material><ambient>0.0 0.0 0.6 1</ambient><diffuse>0.0 0.0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box_3">
      <pose>-0.75 -0.85 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.20 0.20 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material><ambient>0.0 0.0 0.6 1</ambient><diffuse>0.0 0.0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_box_4">
      <pose>0.75 -0.85 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.20 0.20 0.20</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
          <material><ambient>0.0 0.0 0.6 1</ambient><diffuse>0.0 0.0 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== RED (shared/neutral) BOX — 25x25x25 cm, assumed ==================== -->
    <model name="red_box">
      <pose>0 0 0.125 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.25</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.25 0.25 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.25 0.25</size></box></geometry>
          <material><ambient>0.8 0.0 0.0 1</ambient><diffuse>0.8 0.0 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
